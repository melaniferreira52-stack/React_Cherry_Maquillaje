# ============================================================
# Cherry Beauty — Variables de entorno del BACKEND (Railway)
# Copia este archivo como .env en local, o configura estas
# variables en el panel de Railway (Variables).
# ============================================================

# Conexión a MySQL. Local (XAMPP):
DATABASE_URL=mysql+pymysql://root:@localhost:3306/cherry_maquillaje
# En Railway, el servicio MySQL te da una URL parecida a:
# DATABASE_URL=mysql+pymysql://root:PASSWORD@host:3306/railway

# Clave secreta para firmar los JWT. ¡Cámbiala en producción!
# Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_secreta_por_una_generada_con_secrets.token_hex(32)

# Algoritmo y expiración del token (minutos)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URL(s) del frontend permitidas por CORS (separadas por coma si hay varias)
# Local:
FRONTEND_URL=http://localhost:5173
# Producción (Railway): https://cherrybeauty-frontend.up.railway.app

# ---- Correo para recuperación de contraseña (opcional en local) ----
# Si se dejan vacíos, el código se imprime en la consola del backend.
BREVO_SMTP_HOST=smtp.gmail.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
EMAIL_FROM=

# ---- Chatbot IA (OPCIONAL) ----
# El chatbot funciona con su motor local SIN esta clave.
# Si quieres respuestas generadas por IA de verdad, pon tu propia
# API key de OpenAI aquí (nunca la subas a GitHub):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini