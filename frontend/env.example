# ============================================================
# Cherry Beauty — Variables de entorno del FRONTEND (Railway)
# Copia este archivo como .env en local (carpeta frontend), o
# configúralas en el panel de Railway (Variables) para el build.
# ============================================================

# URL base de la API del backend. Local (XAMPP):
VITE_API_URL=http://localhost:8000/api
# Producción (Railway) — la URL pública que Railway asigna al backend:
# VITE_API_URL=https://cherrybeauty-backend.up.railway.app/api